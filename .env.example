# Server-only secrets. Never prefix these with VITE_.
# For Railway, leave SERVER_HOST unset and use the platform-provided PORT.
SERVER_HOST=127.0.0.1
# Railway and other hosts set PORT automatically; SERVER_PORT is a local fallback.
SERVER_PORT=8787
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787
USE_LOCAL_MONGODB=true
MONGODB_LOCAL_PORT=27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=faculty_workspace
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_REQUESTS_PER_MINUTE=5
GEMINI_MAX_REQUESTS_PER_DAY=20
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_USAGE_FILE=.data/gemini-usage.json
# Google Calendar OAuth. Keep the client secret and encryption key server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/google-calendar/callback
# Exactly 64 hexadecimal characters (32 bytes), generated once and kept stable.
GOOGLE_TOKEN_ENCRYPTION_KEY=
