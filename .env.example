# Server-only secrets. Never prefix these with VITE_.
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787
# true: installed MongoDB Community; false: use MONGODB_URI below. Restart Node after changing.
USE_LOCAL_MONGODB=true
MONGODB_LOCAL_PORT=27017
# Preserved while local mode is on. Supports local credentials, Atlas or another MongoDB server.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=faculty_workspace
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Conservative application budgets, NOT a guarantee of Google's current quotas.
GEMINI_MAX_REQUESTS_PER_MINUTE=5
GEMINI_MAX_REQUESTS_PER_DAY=20
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_USAGE_FILE=.data/gemini-usage.json


