{
  "name": "faculty-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/offline-build.mjs",
    "preview": "vite preview",
    "start": "node --experimental-strip-types --env-file-if-exists=.env server/index.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs server/tests/api.test.mjs server/tests/gemini.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "server": "node --experimental-strip-types --env-file-if-exists=.env server/index.mjs",
    "dev:full": "node scripts/dev.mjs",
    "setup": "node scripts/setup-env.mjs",
    "db:check": "node --experimental-strip-types --env-file-if-exists=.env scripts/check-db.mjs",
    "test:db": "node --experimental-strip-types --test server/tests/mongo.test.mjs",
    "mongo:local": "node scripts/mongo-local.mjs",
    "test:e2e": "node --experimental-strip-types scripts/e2e.mjs",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@google/genai": "^2.21.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "mongodb": "^7.6.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "mongodb-memory-server": "^11.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "Standalone React + TypeScript/Vite with a Node backend, MongoDB account persistence, optional Gemini generation, and a separate offline workspace. No OpenAI Sites required.",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
